#!/bin/sh
#
# PROVIDE: cmonit
# REQUIRE: LOGIN DAEMON NETWORKING
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable cmonit:
#
# cmonit_enable (bool):         Set to "NO" by default.
#                               Set it to "YES" to enable cmonit.
# cmonit_user (string):         Set user to run cmonit.
#                               Default is "nobody".
# cmonit_config (string):       Configuration file path (optional).
#                               If not set, automatically searches for config in:
#                               1. /usr/local/etc/cmonit.conf
#                               2. /etc/cmonit.conf
#                               If found, uses config file mode.
#                               Example: "/usr/local/etc/cmonit.conf"
#                               Default is empty (auto-discover or use flags).
# cmonit_flags (string):        Additional command-line flags.
#                               Default is empty.
#                               Example: "-debug -listen 0.0.0.0:3000"
#
# Additional variables:
# cmonit_pidfile (string):      PID file path (default: "/var/run/cmonit/cmonit.pid")
# cmonit_db (string):           Database path (default: "/var/db/cmonit/cmonit.db")
#                               Do not put it under /var/run: FreeBSD deletes the files
#                               there at every boot (cleanvar), which erases all data.
#
# For all other settings, use either cmonit_config or cmonit_flags.

. /etc/rc.subr

name=cmonit
rcvar=cmonit_enable

load_rc_config $name

: ${cmonit_enable:="NO"}
: ${cmonit_user:="nobody"}
: ${cmonit_config:=""}
: ${cmonit_flags:=""}
: ${cmonit_pidfile:="/var/run/cmonit/cmonit.pid"}
: ${cmonit_db:="/var/db/cmonit/cmonit.db"}

pidfile="${cmonit_pidfile}"
command="/usr/local/bin/${name}"

# Auto-discover config file if not explicitly set
# Check standard FreeBSD locations in order:
# 1. /usr/local/etc/cmonit.conf (preferred for ports/packages)
# 2. /etc/cmonit.conf (system-wide config)
if [ -z "${cmonit_config}" ]; then
    if [ -f "/usr/local/etc/cmonit.conf" ]; then
        cmonit_config="/usr/local/etc/cmonit.conf"
    elif [ -f "/etc/cmonit.conf" ]; then
        cmonit_config="/etc/cmonit.conf"
    fi
fi

# Build command arguments
if [ -n "${cmonit_config}" ]; then
    # Config file mode: use -config flag + any additional flags
    command_args="-config ${cmonit_config} -pidfile ${cmonit_pidfile} -db ${cmonit_db} -daemon ${cmonit_flags}"
else
    # CLI-only mode: use -pidfile and -db, let user set everything else via cmonit_flags
    # For backward compatibility, you can still set individual flags in cmonit_flags
    command_args="-pidfile ${cmonit_pidfile} -db ${cmonit_db} ${cmonit_flags} -daemon"
fi

start_precmd="${name}_prestart"

cmonit_prestart()
{
    # Runtime directory for the PID file. /var/run is emptied at boot, so it
    # is recreated here on every start.
    runtime_dir="/var/run/cmonit"
    if [ ! -d "${runtime_dir}" ]; then
        mkdir -p "${runtime_dir}"
        chown ${cmonit_user} "${runtime_dir}"
        chmod 755 "${runtime_dir}"
    fi

    # Database directory. It holds the Monit agent credentials, so it is not
    # world-readable.
    db_dir=$(dirname "${cmonit_db}")
    if [ ! -d "${db_dir}" ]; then
        mkdir -p "${db_dir}"
        chown ${cmonit_user} "${db_dir}"
        chmod 750 "${db_dir}"
    fi
    case "${cmonit_db}" in
    /var/run/*)
        warn "cmonit_db=${cmonit_db} is under /var/run, which is cleared at boot and would erase all data"
        ;;
    esac

    # Ensure database file is writable by cmonit_user
    if [ -f "${cmonit_db}" ]; then
        chown ${cmonit_user} "${cmonit_db}"
    fi

    # Create PID file directory if needed
    pid_dir=$(dirname "${cmonit_pidfile}")
    if [ ! -d "${pid_dir}" ]; then
        mkdir -p "${pid_dir}"
        chmod 755 "${pid_dir}"
    fi
}

run_rc_command "$1"
